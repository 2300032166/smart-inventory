# Local development environment file for SIRA.
# Copy this to backend/.env and fill in your real values.
# Replit Secrets / production env vars override these values when present.

JWT_SECRET_KEY=replace-with-a-strong-secret-for-local-dev
GROQ_API_KEY=your-groq-key-here
GROQ_API_KEY_2=your-second-groq-key-here-optional-but-recommended
CHATBOT_GROQ_API_KEY=your-groq-key-for-chatbot-here
CHATBOT_GROQ_MODEL=llama-3.1-8b-instant
BRIEF_CACHE_HOURS=6
CONFIDENCE_THRESHOLD=60
MAX_BRIEF_ITEMS=100
PAYDAY_DATES=25,26,27
port=4040
context=/
